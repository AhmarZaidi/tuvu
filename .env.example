PUBLIC_APP_URL=http://localhost:8787
APP_NAME=Tuvu

# Provider API keys are added in later phases. Keep real values in Cloudflare
# secrets for deployed environments and in .dev.vars for local Worker dev.
TMDB_API_KEY=
RAWG_API_KEY=
OPEN_LIBRARY_CONTACT_EMAIL=

# Supabase Storage is used for avatars/banners and optional media image cache.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_AVATARS_BUCKET=tuvu-avatars
SUPABASE_STORAGE_MEDIA_CACHE_BUCKET=tuvu-media-cache

# Phase 2 auth. GitHub is the first OAuth provider.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
