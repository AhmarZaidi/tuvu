{
  "name": "tuvu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "npm run build:client && node scripts/dev-worker.mjs",
    "dev:worker:lan": "npm run build:client && node scripts/dev-worker.mjs --lan",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "bundle:report": "vite build --mode analyze",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "worker:types": "wrangler types",
    "export:server": "node scripts/export-server-bundle.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.83.0",
    "@types/papaparse": "^5.5.2",
    "hono": "^4.8.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.24.4"
  }
}
